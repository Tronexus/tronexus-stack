# =============================================================================
# TRONEXUS STACK — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in all required values.
# Lines starting with # are comments. Do not quote values unless noted.
# =============================================================================


# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------

# The base domain for your stack (e.g. example.com or yourdomain.dedyn.io)
TRONEXUS_DOMAIN=yourdomain.com

# Timezone for all services (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Amsterdam


# -----------------------------------------------------------------------------
# POSTGRES
# -----------------------------------------------------------------------------

POSTGRES_USER=tronexus
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=tronexus


# -----------------------------------------------------------------------------
# TRONEXUS AUTH API
# -----------------------------------------------------------------------------

# Google OAuth credentials (from Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT signing secret — generate with: openssl rand -hex 32
AUTH_JWT_SECRET=change_me_generate_with_openssl

# Token expiry settings (defaults are recommended)
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# Base URL of the auth API (no trailing slash)
AUTH_API_BASE_URL=https://auth-api.yourdomain.com

# Auth database name (created automatically on first run)
AUTH_DB_NAME=auth

# App ID — populated automatically after first run bootstrap
AUTH_APP_ID=

# Rate limiting (requests per window per IP)
AUTH_RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_MAX=20
AUTH_LOCKOUT_ATTEMPTS=10
AUTH_LOCKOUT_SECONDS=900


# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Internal only — no external port exposed
# No configuration required unless you change the defaults

REDIS_HOST=tronexus-redis
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# OLLAMA (local inference)
# -----------------------------------------------------------------------------

# Set to true if you have a dedicated GPU inference server
# If false, Ollama runs locally in the stack
OLLAMA_REMOTE=false

# If OLLAMA_REMOTE=true, set the URL of your remote Ollama instance
OLLAMA_REMOTE_URL=http://192.168.1.x:11434

# Default model to load on startup (e.g. mistral, llama3, gemma3)
OLLAMA_DEFAULT_MODEL=mistral:7b-instruct-q4_K_M


# -----------------------------------------------------------------------------
# LITELLM
# -----------------------------------------------------------------------------

# LiteLLM master key — used by Open WebUI and other services to authenticate
# Generate with: openssl rand -hex 16
LITELLM_MASTER_KEY=change_me_generate_with_openssl

# Optional: add remote model API keys if you want to route to external providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=eu-central-1


# -----------------------------------------------------------------------------
# OPEN WEBUI
# -----------------------------------------------------------------------------

# Secret key for Open WebUI sessions
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change_me_generate_with_openssl


# -----------------------------------------------------------------------------
# N8N
# -----------------------------------------------------------------------------

# n8n encryption key for stored credentials
# Generate with: openssl rand -hex 16
N8N_ENCRYPTION_KEY=change_me_generate_with_openssl

# Basic auth for n8n (optional, set N8N_BASIC_AUTH_ACTIVE=true to enable)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me


# -----------------------------------------------------------------------------
# PGADMIN
# -----------------------------------------------------------------------------

PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=change_me_strong_password


# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------

# Telegram bot token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram chat ID to send alerts to (your personal chat or a group)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional: remote inference server IP for health checks
INFERENCE_HOST=

# TLS scan-volume alert: monitor.sh flags a possible scan/attack when tronexus-caddy
# logs more than this many "handshake error" lines in 24h. Public 443 sees constant
# background scanning, so set to ~2x your normal daily count. Find your baseline:
#   docker logs --since 24h tronexus-caddy 2>&1 | grep -c "handshake error"
HANDSHAKE_SCAN_THRESHOLD=10000


# -----------------------------------------------------------------------------
# CADDY / TLS
# -----------------------------------------------------------------------------
# Caddy handles TLS automatically via Let's Encrypt.
# No configuration needed here — domains are derived from TRONEXUS_DOMAIN above.
# Ensure your DNS is pointing to this server before starting the stack.
